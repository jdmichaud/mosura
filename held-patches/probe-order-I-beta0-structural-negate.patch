+/// PROBE ONLY (Order I beta0, never lands): arm the composite-targeted negate for THIS function's
+/// structurings, so `rule_short_circuit` performs Ghidra's `negateCondition` structurally instead of
+/// deferring it to print. Report convergence; the emitted tree is the payoff evidence.
+fn beta_probe(data: &Funcdata) {
+    use super::structure::{beta_on, BETA_DIVERGED, BETA_SITES, BETA_SWAPPED};
+    if !beta_on() {
+        return;
+    }
+    // The tree just built by our caller IS the probe's (beta_on is armed process-wide), so report
+    // its counters rather than structuring again.
+    let swapped = BETA_SWAPPED.with(|c| c.get());
+    let diverged = BETA_DIVERGED.with(|d| d.get());
+    if swapped != 0 {
+        let pcs: Vec<String> = BETA_SITES.with(|v| {
+            v.borrow()
+                .iter()
+                .filter_map(|&(b, i, j, side)| {
+                    let blk = data.block(super::block::BlockId(b));
+                    blk.ops
+                        .iter()
+                        .rev()
+                        .copied()
+                        .find(|&o| data.op(o).code() == super::opcode::OpCode::Cbranch)
+                        .map(|op| (op, i, j, side))
+                })
+                .map(|(op, i, j, side)| {
+                    format!("{:x}/i{i}j{j}{}", data.op(op).seqnum.pc.offset, side as char)
+                })
+                .collect()
+        });
+        println!("BETA0 {} swapped={swapped} diverged={diverged} foldpcs={}", data.name, pcs.join(","));
+    }
+    BETA_SWAPPED.with(|c| c.set(0));
+    BETA_DIVERGED.with(|d| d.set(false));
+}
