# mosura build artifacts (regenerated by scripts/setup-oracle.sh)
/build/

# Rust
/target/
**/*.rs.bk
Cargo.lock.bak

# local throwaway grounding tools (dump the IR/scope of a fixture); never committed.
# For "what is this file?" (container/compiler/language/cspec/FID) do NOT write one: use the
# committed `examples/identify.rs`. If it can't answer, extend it — that is the maintained path.
# The runner examples/trace.rs and dumpc.rs ARE tracked (grounding tools kept for the port).
/crates/mosura/examples/dump*.rs
!/crates/mosura/examples/dumpc.rs

# offline capture tool (binary built by setup-oracle.sh; source is tracked)
/oracle/capture
# rule-application trace tool (binary built by setup-oracle.sh; source is tracked)
/oracle/capture_trace
/oracle/capture_merge
/oracle/capture_typeprop
/oracle/*.o

# Generated test goldens are committed deliberately; nothing here.
# NOTE: the standalone oracle tools and compiled *.sla live under ../ghidra and
# are ignored by Ghidra's own .gitignore — they are not part of this repo.

# python bytecode cache for the scripts/ measurement tools (regenerated on every run)
/scripts/__pycache__/
