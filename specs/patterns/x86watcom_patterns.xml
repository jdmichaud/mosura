     <codeboundary/>
     <possiblefuncstart/>
  </pattern>
  <pattern>
     <data>0x5589e581ec....0000</data> <!-- PUSH EBP : MOV EBP,ESP : SUB ESP,#bigconst -->
     <codeboundary/>
     <possiblefuncstart/>
  </pattern>
  <!-- x86gcc #3/#4: `sub esp` after 1-2 other bytes -->
  <pattern>
     <data>0x5589e5..83ec</data> <!-- PUSH EBP : MOV EBP,ESP : 1 byte : SUB ESP, -->
