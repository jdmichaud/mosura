<?xml version="1.0" encoding="UTF-8"?>

<!--
  x86-32 Watcom compiler spec (watcall) — a BEYOND-GHIDRA extension. No Ghidra x86 processor
  ships a watcom cspec (verified: x86/data/languages has gcc/win/borland/delphi/golang/swift,
  none watcom). This models the default Watcom C/C++ 32-bit register calling convention
  (`__watcall`), grounded in Open Watcom source + docs (not memory):

    - Argument registers, in order: EAX, EDX, EBX, ECX, then the stack. Grounded in
      open-watcom-v2 `bld/watcom/h/owflat.h:519` (`__parm [__eax] [__edx] [__ebx] [__ecx]`)
      and `bld/wasm/c/asmins.c:935` (`{ "eax", "edx", "ebx", "ecx" }`).
    - Integer/pointer return in EAX (docs/doc/cg/cpwcc.gml: a struct return passes a pointer
      in EAX; a scalar returns in AX/EAX).
    - Caller-saved (killed by call): EAX, ECX, EDX — cpwcc.gml: "For the 32-bit compiler,
      registers EAX, ECX and EDX are not saved and restored when a call is made."
    - Callee-saved (preserved / unaffected): EBX, ESI, EDI, EBP, ESP (and DF) — everything
      not in the killed set; note EBX is BOTH an argument register AND preserved (the callee
      saves/restores it), matching the warcraft2-re observation that Watcom saves EBX/ESI/EDI.

  Register-convention symbols carry a *trailing* underscore (`foo_`) vs the leading underscore
  of the stack `__cdecl` convention (cpwcc.gml) — a symbol-decoration detail, not part of the
  storage model below.

  Structure mirrors Ghidra's own register-convention cspec x86borland.cspec (__fastcall);
  the data organization is the shared i386 flat model.
-->
<compiler_spec>
  <data_organization>
     <absolute_max_alignment value="0" />
     <machine_alignment value="2" />
     <default_alignment value="1" />
     <default_pointer_alignment value="4" />
     <pointer_size value="4" />
     <wchar_size value="2" />
     <short_size value="2" />
     <integer_size value="4" />
     <long_size value="4" />
     <long_long_size value="8" />
     <float_size value="4" />
     <double_size value="8" />
     <long_double_size value="8" />
     <size_alignment_map>
          <entry size="1" alignment="1" />
          <entry size="2" alignment="2" />
          <entry size="4" alignment="4" />
          <entry size="8" alignment="4" />
     </size_alignment_map>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="ESP" space="ram"/>
  <default_proto>
    <prototype name="__watcall" extrapop="unknown" stackshift="4">
      <input>
        <pentry minsize="1" maxsize="4">
          <register name="EAX"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="EDX"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="EBX"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="ECX"/>
        </pentry>
        <pentry minsize="1" maxsize="500" align="4">
          <addr offset="4" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="EAX"/>
        </pentry>
      </output>
      <unaffected>
        <register name="ESP"/>
        <register name="EBP"/>
        <register name="ESI"/>
        <register name="EDI"/>
        <register name="EBX"/>
        <register name="DF"/>
      </unaffected>
      <killedbycall>
        <register name="EAX"/>
        <register name="ECX"/>
        <register name="EDX"/>
      </killedbycall>
    </prototype>
  </default_proto>
</compiler_spec>
